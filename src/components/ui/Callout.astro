---
interface Props {
  variant?: 'info' | 'warning';
  title?: string;
}

const { variant = 'info', title } = Astro.props;
---

<aside class:list={['callout', variant === 'warning' && 'callout--warning']}>
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__body"><slot /></div>
</aside>
