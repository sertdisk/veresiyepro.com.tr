---
import Icon from './Icon.astro';
import { SECURITY_CARDS } from '../../data/marketing';
---

<section class="security" id="guvenlik">
  <div class="security__grid" aria-hidden="true"></div>
  <div class="security__glow" aria-hidden="true"></div>

  <div class="container security__inner">
    <div class="security__head">
      <div class="security__headline">
        <p class="security__eyebrow">
          <span class="security__index">07</span>
          <span class="security__rule" aria-hidden="true"></span>
          Gizlilik &amp; kesintisiz çalışma
        </p>
        <h2 class="security__title">İnternetsiz çalışan veresiye programı: veriniz sizde kalır.</h2>
        <p class="security__lead">
          Veresiye kayıtlarınız bilgisayarınızdaki şifreli yerel veritabanında tutulur. İnternetiniz
          tamamen kesilse bile kayıt, tahsilat, taksit ve analiz işlemlerinizi eksiksiz sürdürürsünüz.
        </p>
      </div>

      <div class="security__status" aria-hidden="true">
        <div class="security__status-head">
          <span class="security__status-dot"></span>
          Çevrimdışı mod
          <span class="security__status-tag">güvende</span>
        </div>
        <div class="security__status-body">
          <span>Yerel veritabanı</span>
          <span class="security__status-line"><i></i></span>
          <span class="security__status-ok"><Icon name="check" size={11} strokeWidth={2.6} /> şifreli</span>
        </div>
        <div class="security__status-body">
          <span>Son yedek</span>
          <span class="security__status-line"><i style="width: 86%"></i></span>
          <span class="security__status-muted">12 dk önce</span>
        </div>
      </div>
    </div>

    <div class="security__cards">
      {
        SECURITY_CARDS.map((card, i) => (
          <article class="security__card">
            <span class="security__card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="security__icon" aria-hidden="true">
              <Icon name={card.icon} size={21} />
            </span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))
      }
    </div>

    <ul class="security__footer">
      <li><Icon name="wifi-off" size={15} /> Bağlantı olmadan tam işlev</li>
      <li><Icon name="database" size={15} /> Yerel + bulut iki katmanlı yedek</li>
      <li><Icon name="lock" size={15} /> Lisans bitse de veri erişimi sürer</li>
    </ul>
  </div>
</section>

<style>
  .security {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-9);
    background:
      radial-gradient(760px 420px at 90% 0%, rgb(6 182 212 / 0.16), transparent 62%),
      radial-gradient(620px 380px at 0% 100%, rgb(29 78 216 / 0.28), transparent 68%),
      linear-gradient(160deg, #0c2050 0%, #081838 50%, #050f26 100%);
    color: rgb(226 234 248 / 0.76);
  }

  .security__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(110% 80% at 50% 0%, #000 10%, transparent 76%);
    pointer-events: none;
  }

  .security__glow {
    position: absolute;
    z-index: -1;
    right: -140px;
    bottom: -180px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.1), transparent 68%);
    pointer-events: none;
  }

  .security__head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: var(--space-7);
  }

  .security__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan-300);
  }

  .security__index {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.4);
  }

  .security__rule {
    width: 26px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-cyan-300), transparent);
  }

  .security__title {
    margin-block: 0.9rem 0.9rem;
    font-size: var(--text-h2);
    line-height: 1.16;
    color: #fff;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .security__lead {
    max-width: 62ch;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: rgb(226 234 248 / 0.7);
  }

  .security__status {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.045);
    border: 1px solid rgb(255 255 255 / 0.1);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .security__status-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.7rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: var(--text-xs);
    font-weight: 700;
    color: #fff;
  }

  .security__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px rgb(16 185 129 / 0.16);
  }

  .security__status-tag {
    margin-left: auto;
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgb(16 185 129 / 0.14);
    color: #6ee7b7;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .security__status-body {
    display: grid;
    grid-template-columns: auto minmax(40px, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    color: rgb(226 234 248 / 0.55);
  }

  .security__status-body + .security__status-body {
    margin-top: 0.55rem;
  }

  .security__status-line {
    height: 3px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }

  .security__status-line i {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-success));
  }

  .security__status-ok {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #6ee7b7;
    font-weight: 700;
  }

  .security__status-muted {
    font-variant-numeric: tabular-nums;
  }

  .security__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .security__card {
    position: relative;
    overflow: hidden;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.045);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .security__card:hover {
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(6 182 212 / 0.35);
    transform: translateY(-3px);
  }

  .security__card-num {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 0.22);
  }

  .security__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgb(6 182 212 / 0.12);
    border: 1px solid rgb(6 182 212 / 0.24);
    color: var(--color-cyan-300);
    margin-bottom: var(--space-4);
  }

  .security__card h3 {
    font-size: 1.0625rem;
    line-height: 1.32;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .security__card p {
    font-size: var(--text-sm);
    line-height: 1.62;
    color: rgb(226 234 248 / 0.66);
  }

  .security__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: var(--text-xs);
    color: rgb(226 234 248 / 0.6);
  }

  .security__footer li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .security__footer :global(svg) {
    color: var(--color-cyan-300);
  }

  @media (max-width: 1040px) {
    .security__head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .security__status {
      max-width: 380px;
    }
  }

  @media (max-width: 860px) {
    .security__cards {
      grid-template-columns: 1fr;
    }

    .security__footer {
      display: grid;
      gap: 0.6rem;
    }
  }
</style>
