---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import TestimonialCard from '../content/TestimonialCard.astro';
import Icon from './Icon.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
}

const { testimonials } = Astro.props;
---

<section class="testimonials" id="referanslar">
  <div class="container">
    <div class="testimonials__head">
      <SectionHeading
        index="09"
        eyebrow="Referanslar"
        title="Veresiye Pro kullananlar ne diyor?"
        description="Küçük işletmeler ve esnaflar, veresiye yönetimlerini nasıl daha planlı hale getirdi?"
      />
      <a class="testimonials__all" href="/referanslar/">
        Tüm referansları görüntüle
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <div class="testimonials__grid">
      {testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
    </div>

    <p class="testimonials__note">
      <Icon name="alert" size={15} />
      <span>
        Bu sayfadaki görüşler yayın öncesi hazırlanmış örnek içeriklerdir. Gerçek kullanıcı
        deneyimleri, izinleriyle birlikte yayına eklenecektir.
      </span>
    </p>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-9);
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }

  .testimonials__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .testimonials__head :global(.section-heading) {
    margin-bottom: var(--space-6);
  }

  .testimonials__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding-bottom: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .testimonials__all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .testimonials__note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--color-muted);
    background: rgb(255 255 255 / 0.6);
  }

  .testimonials__note :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--color-gold-dark);
  }

  @media (max-width: 980px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }

    .testimonials__head {
      display: block;
    }

    .testimonials__all {
      padding-bottom: var(--space-5);
    }
  }
</style>
