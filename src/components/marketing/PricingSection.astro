---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from './Icon.astro';
import { LINKS, PRICING } from '../../data/site';

const premiumFeatures = [
  'Bekleyen İşlemler ön planda: gecikmişler ve bugün beklenenler ana ekranda ve müşteri sayfasında',
  'Otomatik yedekleme: veriler otomatik yedeklenir, gün sonu yedeği sunucuda saklanır',
  'QR ile iletişim: QR okutup hazır SMS, WhatsApp mesajı ve telefon araması başlatın',
  '5 boyutlu finansal radar: en yüksekler, yükselenler, geciktirenler, unutanlar ve nakit geleceği',
  'Akıllı müşteri listeleri: özel filtreler ve hazır listelerle hızlı inceleme',
  'Gelecek tüm premium avantajları lisans süresince dahil',
];
---

<section class="pricing" id="premium">
  <div class="container">
    <div class="pricing__head">
      <SectionHeading
        index="08"
        eyebrow="Eksiksiz profesyonel finans"
        title="Veresiye Pro Premium lisansı"
        description="Tek lisansla tüm premium avantajlar. Yıllık yenilemelerde %40 indirim uygulanır."
      />
      <p class="pricing__head-note">
        <Icon name="windows" size={15} />
        Windows 10 &amp; 11 · masaüstü uygulaması
      </p>
    </div>

    <div class="pricing__card">
      <div class="pricing__glow" aria-hidden="true"></div>
      <div class="pricing__pattern" aria-hidden="true"></div>

      <div class="pricing__left">
        <span class="pricing__badge">
          <Icon name="spark" size={13} />
          Premium
        </span>

        <h3 class="pricing__title">Veresiye Pro Premium</h3>
        <p class="pricing__desc">
          Yalnızca Premium'a özel akıllı takip, analiz ve güvenlik avantajlarının tamamı tek
          lisansta.
        </p>

        <div class="pricing__price">
          <span class="pricing__price-label">İlk yıl</span>
          <strong class="pricing__price-value">
            {PRICING.firstYear}
            <small>/yıl</small>
          </strong>
        </div>

        <div class="pricing__renewal">
          <span class="pricing__discount">%{PRICING.discountPercent} indirim</span>
          <span class="pricing__renewal-text">
            Yenileme:{' '}
            <s>{PRICING.renewalBase}</s>{' '}
            <strong>{PRICING.renewal}</strong>{' '}
            <span>/yıl</span>
          </span>
        </div>

        <Button variant="gold" size="lg" href={LINKS.panelSignup} external>
          Hemen lisansınızı başlatın
          <Icon name="arrow-right" size={17} />
        </Button>

        <p class="pricing__note">{PRICING.note}</p>

        <ul class="pricing__assurance">
          <li><Icon name="check" size={13} strokeWidth={2.2} /> İnternetsiz çalışır</li>
          <li><Icon name="check" size={13} strokeWidth={2.2} /> Ömür boyu veri erişimi</li>
          <li><Icon name="check" size={13} strokeWidth={2.2} /> 0 TL QR iletişim</li>
        </ul>
      </div>

      <div class="pricing__right">
        <p class="pricing__features-title">Premium'a dahil</p>
        <ul class="pricing__features">
          {
            premiumFeatures.map((feature) => (
              <li>
                <span class="pricing__check" aria-hidden="true">
                  <Icon name="check" size={12} strokeWidth={2.6} />
                </span>
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--space-9);
    background:
      radial-gradient(760px 380px at 50% 0%, rgb(245 158 11 / 0.06), transparent 65%),
      var(--color-surface);
  }

  .pricing__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .pricing__head :global(.section-heading) {
    margin-bottom: var(--space-6);
  }

  .pricing__head-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding-bottom: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .pricing__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.6rem, 4vw, 3.25rem);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(520px 320px at 6% 0%, rgb(245 158 11 / 0.16), transparent 62%),
      radial-gradient(420px 300px at 100% 100%, rgb(6 182 212 / 0.1), transparent 68%),
      linear-gradient(155deg, #0f2454 0%, #0b1e4b 48%, #071431 100%);
    border: 1px solid rgb(245 158 11 / 0.34);
    box-shadow:
      0 0 0 1px rgb(245 158 11 / 0.08),
      0 40px 80px -40px rgb(4 13 34 / 0.7);
    color: rgb(226 234 248 / 0.76);
  }

  .pricing__glow {
    position: absolute;
    z-index: -1;
    top: -160px;
    left: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.22), transparent 68%);
    filter: blur(8px);
    pointer-events: none;
  }

  .pricing__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(90% 90% at 100% 0%, #000, transparent 72%);
    pointer-events: none;
  }

  .pricing__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .pricing__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgb(245 158 11 / 0.16);
    border: 1px solid rgb(245 158 11 / 0.32);
    color: #fcd34d;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pricing__title {
    margin-top: var(--space-4);
    font-size: var(--text-h2);
    line-height: 1.15;
    color: #fff;
    letter-spacing: -0.03em;
  }

  .pricing__desc {
    margin-top: 0.5rem;
    max-width: 40ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgb(226 234 248 / 0.66);
  }

  .pricing__price {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: var(--space-5);
  }

  .pricing__price-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(226 234 248 / 0.5);
  }

  .pricing__price-value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .pricing__price-value small {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: rgb(226 234 248 / 0.5);
    margin-left: 0.3rem;
  }

  .pricing__renewal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    margin-top: 0.7rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-md);
    background: rgb(245 158 11 / 0.09);
    border: 1px solid rgb(245 158 11 / 0.22);
    font-size: var(--text-xs);
  }

  .pricing__discount {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-gold);
    color: var(--color-navy-950);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .pricing__renewal-text {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    color: rgb(226 234 248 / 0.72);
  }

  .pricing__renewal-text s {
    color: rgb(226 234 248 / 0.4);
  }

  .pricing__renewal-text strong {
    color: #fcd34d;
    font-size: var(--text-sm);
  }

  .pricing__left :global(.btn) {
    width: 100%;
    margin-top: var(--space-5);
  }

  .pricing__note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: rgb(226 234 248 / 0.62);
  }

  .pricing__assurance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    font-size: var(--text-xs);
    color: rgb(226 234 248 / 0.6);
  }

  .pricing__assurance li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .pricing__assurance :global(svg) {
    color: var(--color-cyan-300);
  }

  /* ---- Sağ kolon ---- */
  .pricing__right {
    display: flex;
    flex-direction: column;
    padding-left: clamp(0rem, 3vw, 2rem);
    border-left: 1px solid rgb(255 255 255 / 0.1);
  }

  .pricing__features-title {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan-300);
    margin-bottom: var(--space-4);
  }

  .pricing__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .pricing__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: rgb(226 234 248 / 0.8);
  }

  .pricing__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 1px;
    border-radius: 50%;
    background: rgb(6 182 212 / 0.14);
    color: var(--color-cyan-300);
  }

  @media (max-width: 960px) {
    .pricing__head {
      display: block;
    }

    .pricing__head-note {
      display: flex;
      padding-bottom: var(--space-5);
    }

    .pricing__card {
      grid-template-columns: minmax(0, 1fr);
    }

    .pricing__right {
      padding-left: 0;
      padding-top: var(--space-5);
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.1);
    }
  }

  @media (max-width: 560px) {
    .pricing__card {
      padding: var(--space-5) var(--space-4);
      border-radius: var(--radius-xl);
    }

    .pricing__renewal {
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .pricing__left :global(.btn) {
      white-space: normal;
      padding-inline: 1rem;
      line-height: 1.3;
    }
  }
</style>
