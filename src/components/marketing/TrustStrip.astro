---
import Icon from './Icon.astro';
import { TRUST_ITEMS } from '../../data/marketing';
---

<section class="trust" aria-label="Ürünün temel güvenceleri">
  <div class="container trust__grid">
    {
      TRUST_ITEMS.map((item) => (
        <div class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            <Icon name={item.icon} size={19} />
          </span>
          <span class="trust__body">
            <span class="trust__title">{item.title}</span>
            <span class="trust__text">{item.text}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    position: relative;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .trust__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: var(--space-5);
  }

  .trust__item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.35rem var(--space-4);
  }

  .trust__item + .trust__item {
    border-left: 1px solid var(--color-border);
  }

  .trust__item:first-child {
    padding-left: 0;
  }

  .trust__item:last-child {
    padding-right: 0;
  }

  .trust__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 11px;
    color: var(--color-primary);
    background:
      linear-gradient(180deg, #fff, var(--color-blue-050));
    border: 1px solid var(--color-blue-100);
    box-shadow: inset 0 1px 0 #fff;
  }

  .trust__body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .trust__title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .trust__text {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 1020px) {
    .trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) 0;
      padding-block: var(--space-5);
    }

    .trust__item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    .trust__item:nth-child(4) {
      padding-right: 0;
    }
  }

  @media (max-width: 560px) {
    .trust__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .trust__item {
      padding: 0.85rem 0;
    }

    .trust__item + .trust__item {
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
