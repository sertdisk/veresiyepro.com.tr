---
import Button from '../ui/Button.astro';
import Icon from './Icon.astro';
import { LINKS, PRICING } from '../../data/site';
---

<section class="final">
  <div class="final__grid" aria-hidden="true"></div>
  <div class="final__glow" aria-hidden="true"></div>

  <div class="container final__inner">
    <div class="final__copy">
      <p class="final__eyebrow">
        <span class="final__dot" aria-hidden="true"></span>
        Bugün başlayın
      </p>
      <h2 class="final__title">
        Veresiyeyi defterden çıkarın,
        <span>planla yönetin.</span>
      </h2>
      <p class="final__lead">
        Veresiye Pro Premium ile geciken tahsilatları görün, bugünün işlerini kaçırmayın ve nakit
        akışınızı güvenceye alın. Windows masaüstü uygulaması, internetsiz çalışır.
      </p>
      <ul class="final__chips">
        <li>Windows 10 &amp; 11</li>
        <li>İnternetsiz çalışma</li>
        <li>İlk yıl {PRICING.firstYear}</li>
      </ul>
    </div>

    <div class="final__actions">
      <Button variant="gold" size="lg" href={LINKS.panelSignup} external>
        Premium lisans satın al
        <Icon name="arrow-right" size={17} />
      </Button>
      <Button variant="glass" size="lg" href={LINKS.download} external>
        <Icon name="download" size={17} />
        Windows kurulumunu indir
      </Button>
      <p class="final__note">
        Lisans panelden başlatılır · Kurulumdan sonra tüm kayıtlar yerel olarak sizde kalır
      </p>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-9);
    background:
      radial-gradient(700px 400px at 88% 10%, rgb(6 182 212 / 0.2), transparent 62%),
      radial-gradient(600px 380px at 0% 100%, rgb(29 78 216 / 0.32), transparent 68%),
      linear-gradient(150deg, #0d2252 0%, #0a1c46 45%, #06122c 100%);
    color: rgb(226 234 248 / 0.76);
    border-top: 1px solid rgb(245 158 11 / 0.25);
  }

  .final__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(100% 90% at 50% 0%, #000 10%, transparent 80%);
    pointer-events: none;
  }

  .final__glow {
    position: absolute;
    z-index: -1;
    bottom: -200px;
    right: -100px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.13), transparent 70%);
    pointer-events: none;
  }

  .final__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .final__copy {
    max-width: 42rem;
  }

  .final__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-cyan-300);
  }

  .final__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 0 3px rgb(245 158 11 / 0.16);
  }

  .final__title {
    margin-block: 1rem 1rem;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }

  .final__title span {
    display: block;
    background: linear-gradient(96deg, #7df3ff 0%, #67e8f9 40%, #fcd34d 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.05em;
  }

  .final__lead {
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: rgb(226 234 248 / 0.7);
  }

  .final__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .final__chips li {
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.04);
    font-size: var(--text-xs);
    color: rgb(226 234 248 / 0.7);
  }

  .final__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .final__actions :global(.btn) {
    width: 100%;
  }

  .final__note {
    font-size: var(--text-xs);
    line-height: 1.55;
    text-align: center;
    color: rgb(226 234 248 / 0.48);
    margin-top: 0.25rem;
  }

  @media (max-width: 960px) {
    .final__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .final__actions {
      max-width: 420px;
    }
  }

  @media (max-width: 380px) {
    .final__actions :global(.btn) {
      white-space: normal;
      padding-inline: 1rem;
      line-height: 1.3;
    }
  }

  @media (max-width: 480px) {
    .final__chips {
      display: grid;
      justify-items: start;
    }

    .final__actions {
      padding: var(--space-4);
    }
  }
</style>
