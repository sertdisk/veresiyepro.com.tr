---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from './Icon.astro';
import { PENDING_POINTS } from '../../data/marketing';
import { LINKS } from '../../data/site';
---

<section class="pending" id="bekleyen-islemler">
  <div class="pending__dots" aria-hidden="true"></div>

  <div class="container pending__inner">
    <div class="pending__copy">
      <SectionHeading
        index="02"
        eyebrow="En büyük avantajımız"
        title="İşlem geçmişine değil, yapılacak işlemlere odaklanın"
        description="Ana ekranı açtığınızda önce geciken ve bugün gerçekleşmesi beklenen işlemler listelenir. Kasanız geçmişe bakılarak değil, bugünün planına göre yönetilir."
      />

      <ul class="pending__list">
        {
          PENDING_POINTS.map((point) => (
            <li class="pending__point">
              <span class="pending__point-icon" aria-hidden="true">
                <Icon name={point.icon} size={17} />
              </span>
              <span class="pending__point-body">
                <span class="pending__point-title">{point.title}</span>
                <span class="pending__point-text">{point.text}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="pending__actions">
        <Button variant="primary" href={LINKS.panelSignup} external>
          Premium'u Keşfedin
          <Icon name="arrow-right" size={16} />
        </Button>
        <a class="pending__text-link" href="/yardim/tahsilat-kaydi/">Tahsilat nasıl kaydedilir? →</a>
      </div>
    </div>

    <div class="pending__stage">
      <div class="pending__plate" aria-hidden="true"></div>

      <div class="pending__panel" aria-hidden="true">
        <div class="pending__panel-head">
          <div>
            <p class="pending__panel-kicker">Bugünkü plan</p>
            <p class="pending__panel-date">6 Kasım 2026 · Cuma</p>
          </div>
          <span class="pending__panel-refresh">
            <Icon name="clock" size={12} />
            Canlı
          </span>
        </div>

        <div class="pending__summary">
          <div>
            <span class="pending__summary-label">Bekleyen işlem</span>
            <strong class="pending__summary-value">3</strong>
          </div>
          <div>
            <span class="pending__summary-label">Toplam tutar</span>
            <strong class="pending__summary-value">₺16.350</strong>
          </div>
          <span class="pending__summary-bar">
            <i style="width: 62%"></i>
          </span>
        </div>

        <p class="pending__group-label">
          <span class="pending__group-dot pending__group-dot--late"></span>
          Gecikmiş
        </p>
        <div class="pending__row pending__row--late">
          <span class="pending__row-avatar">Dİ</span>
          <span class="pending__row-main">
            <span class="pending__row-name">Demir İnşaat Ltd.</span>
            <span class="pending__row-meta">Vadeli borç · 3 gün gecikme</span>
          </span>
          <span class="pending__row-amount">₺9.700</span>
          <span class="pending__row-action">Öde</span>
        </div>

        <p class="pending__group-label">
          <span class="pending__group-dot pending__group-dot--today"></span>
          Bugün
        </p>
        <div class="pending__row">
          <span class="pending__row-avatar pending__row-avatar--blue">AY</span>
          <span class="pending__row-main">
            <span class="pending__row-name">Ahmet Yılmaz</span>
            <span class="pending__row-meta">Taksitli veresiye 2/4 · vade bugün</span>
          </span>
          <span class="pending__row-amount">₺4.500</span>
          <span class="pending__row-action">Tahsil et</span>
        </div>
        <div class="pending__row">
          <span class="pending__row-avatar pending__row-avatar--gold">KT</span>
          <span class="pending__row-main">
            <span class="pending__row-name">Kaya Ticaret</span>
            <span class="pending__row-meta">Veresiye · 2 gün kaldı</span>
          </span>
          <span class="pending__row-amount">₺2.150</span>
          <span class="pending__row-action">Tahsil et</span>
        </div>

        <div class="pending__panel-foot">
          <span>Gecikmiş toplam</span>
          <strong>₺9.700</strong>
        </div>
      </div>

      <p class="pending__caption">Örnek arayüz · temsili demo verileri</p>
    </div>
  </div>
</section>

<style>
  .pending {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-9);
    background:
      radial-gradient(700px 380px at 100% 100%, rgb(6 182 212 / 0.07), transparent 65%),
      var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .pending__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(11 30 75 / 0.09) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(105deg, transparent 45%, #000 100%);
    pointer-events: none;
  }

  .pending__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .pending__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .pending__point {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .pending__point-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 9px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    box-shadow: var(--shadow-xs);
  }

  .pending__point-body {
    display: grid;
    gap: 0.1rem;
    padding-top: 0.15rem;
  }

  .pending__point-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .pending__point-text {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.55;
  }

  .pending__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .pending__text-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .pending__text-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Sahne ---- */
  .pending__stage {
    position: relative;
    min-width: 0;
    padding: var(--space-4) 0;
  }

  .pending__plate {
    position: absolute;
    inset: 12% -2% 4% 4%;
    border-radius: var(--radius-xl);
    background: linear-gradient(150deg, rgb(29 78 216 / 0.1), rgb(6 182 212 / 0.14));
    border: 1px solid rgb(29 78 216 / 0.12);
    transform: rotate(2.2deg);
  }

  .pending__panel {
    position: relative;
    padding: var(--space-5);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    transform: rotate(-0.6deg);
    font-variant-numeric: tabular-nums;
  }

  .pending__panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .pending__panel-kicker {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }

  .pending__panel-date {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .pending__panel-refresh {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: rgb(16 185 129 / 0.1);
    color: var(--color-success-ink);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .pending__summary {
    position: relative;
    display: flex;
    gap: var(--space-6);
    padding: var(--space-4) 0 var(--space-5);
  }

  .pending__summary-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .pending__summary-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.03em;
  }

  .pending__summary-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    height: 4px;
    border-radius: 4px;
    background: var(--color-surface-tint);
    overflow: hidden;
  }

  .pending__summary-bar i {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  }

  .pending__group-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-4);
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-muted);
  }

  .pending__group-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pending__group-dot--late {
    background: var(--color-danger);
  }

  .pending__group-dot--today {
    background: var(--color-gold);
  }

  .pending__row {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .pending__row-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fde8e8;
    color: var(--color-danger-ink);
    font-size: 0.625rem;
    font-weight: 800;
  }

  .pending__row-avatar--blue {
    background: var(--color-blue-050);
    color: var(--color-primary);
  }

  .pending__row-avatar--gold {
    background: var(--color-gold-100);
    color: var(--color-gold-ink);
  }

  .pending__row-main {
    display: grid;
    min-width: 0;
  }

  .pending__row-name {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.015em;
  }

  .pending__row-meta {
    font-size: 0.6875rem;
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pending__row-amount {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .pending__row--late .pending__row-amount {
    color: var(--color-danger-ink);
  }

  .pending__row-action {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.6563rem;
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .pending__panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .pending__panel-foot strong {
    font-size: var(--text-sm);
    color: var(--color-danger-ink);
  }

  .pending__caption {
    margin-top: var(--space-4);
    text-align: right;
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  @media (max-width: 980px) {
    .pending__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .pending__stage {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    .pending__panel {
      padding: var(--space-4);
    }

    .pending__row {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: var(--space-2);
    }

    .pending__row-action {
      display: none;
    }

    .pending__summary {
      gap: var(--space-5);
    }

    .pending__caption {
      text-align: left;
      margin-top: var(--space-3);
    }

    .pending__panel-date {
      font-size: var(--text-md);
    }
  }
</style>
