---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from './Icon.astro';
import { COMPARISON } from '../../data/marketing';
---

<section class="compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="compare__head">
      <SectionHeading
        index="03"
        id="compare-title"
        eyebrow="Yöntem farkı"
        title="Aynı işletme, farklı bir sabah"
        description="Defter ve Excel'de dağınık kalan veresiye takibi yerine, güne hazır bir planla başlayın."
      />
      <p class="compare__note">
        Karşılaştırma, günlük veresiye akışındaki tipik farkları özetler.
      </p>
    </div>

    <div class="compare__grid">
      <article class="compare__card compare__card--old">
        <header class="compare__card-head">
          <span class="compare__tag">
            <Icon name="document" size={14} />
            {COMPARISON.old.label}
          </span>
          <h3>{COMPARISON.old.title}</h3>
        </header>
        <ul class="compare__list">
          {
            COMPARISON.old.items.map((item) => (
              <li>
                <span class="compare__mark" aria-hidden="true">×</span>
                {item}
              </li>
            ))
          }
        </ul>
      </article>

      <span class="compare__vs" aria-hidden="true">vs</span>

      <article class="compare__card compare__card--new">
        <div class="compare__glow" aria-hidden="true"></div>
        <header class="compare__card-head">
          <span class="compare__tag">
            <Icon name="spark" size={14} />
            {COMPARISON.modern.label}
          </span>
          <h3>{COMPARISON.modern.title}</h3>
        </header>
        <ul class="compare__list">
          {
            COMPARISON.modern.items.map((item) => (
              <li>
                <span class="compare__mark" aria-hidden="true">
                  <Icon name="check" size={12} strokeWidth={2.6} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .compare {
    padding-block: var(--space-9);
    background: var(--color-surface);
  }

  .compare__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .compare__head :global(.section-heading) {
    margin-bottom: 0;
  }

  .compare__note {
    max-width: 24ch;
    padding-bottom: 0.35rem;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-muted);
    text-align: right;
  }

  .compare__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .compare__card {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
  }

  .compare__card--old {
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0,
        transparent 33px,
        rgb(11 30 75 / 0.045) 33px,
        rgb(11 30 75 / 0.045) 34px
      ),
      #fbfaf7;
    border: 1px solid #e9e3d9;
  }

  .compare__card--new {
    background:
      radial-gradient(420px 240px at 100% 0%, rgb(6 182 212 / 0.22), transparent 68%),
      linear-gradient(150deg, #10265a 0%, #0b1e4b 55%, #071431 100%);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: var(--shadow-lg);
    color: rgb(226 234 248 / 0.82);
  }

  .compare__glow {
    position: absolute;
    right: -60px;
    bottom: -80px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 158 11 / 0.14), transparent 70%);
    pointer-events: none;
  }

  .compare__card-head {
    position: relative;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid rgb(11 30 75 / 0.1);
  }

  .compare__card--new .compare__card-head {
    border-bottom-color: rgb(255 255 255 / 0.12);
  }

  .compare__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8a7f6c;
  }

  .compare__card--new .compare__tag {
    color: var(--color-cyan-300);
  }

  .compare__card h3 {
    margin-top: 0.6rem;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: #4a4136;
    letter-spacing: -0.02em;
  }

  .compare__card--new h3 {
    color: #fff;
  }

  .compare__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .compare__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: #6d6355;
  }

  .compare__card--new .compare__list li {
    color: rgb(226 234 248 / 0.82);
  }

  .compare__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 1px;
    border-radius: 50%;
    background: rgb(180 60 60 / 0.1);
    color: #a05252;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
  }

  .compare__card--new .compare__mark {
    background: rgb(6 182 212 / 0.16);
    color: var(--color-cyan-300);
  }

  .compare__vs {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 880px) {
    .compare__head {
      display: block;
    }

    .compare__note {
      margin-top: var(--space-3);
      text-align: left;
      max-width: 52ch;
    }

    .compare__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .compare__vs {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: -0.2rem auto;
      width: 44px;
      height: 44px;
    }

    .compare__card {
      padding: var(--space-5);
    }
  }
</style>
