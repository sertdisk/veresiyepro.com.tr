---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from './Icon.astro';
import { RADAR_DIMENSIONS } from '../../data/marketing';

const cx = 160;
const cy = 152;
const radius = 104;
const angle = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / 5;
const point = (i: number, r: number) => ({
  x: Number((cx + r * Math.cos(angle(i))).toFixed(2)),
  y: Number((cy + r * Math.sin(angle(i))).toFixed(2)),
});

const rings = [0.25, 0.5, 0.75, 1].map((scale) =>
  RADAR_DIMENSIONS.map((_, i) => point(i, radius * scale))
    .map((p) => `${p.x},${p.y}`)
    .join(' '),
);

const spokes = RADAR_DIMENSIONS.map((_, i) => point(i, radius));

const dataValues = [0.86, 0.62, 0.74, 0.45, 0.58];
const dataPolygon = RADAR_DIMENSIONS.map((_, i) => point(i, radius * dataValues[i]))
  .map((p) => `${p.x},${p.y}`)
  .join(' ');

const labels = RADAR_DIMENSIONS.map((dimension, i) => {
  const p = point(i, radius + 22);
  const cos = Math.cos(angle(i));
  const anchor = cos > 0.25 ? 'start' : cos < -0.25 ? 'end' : 'middle';
  return { ...dimension, ...p, anchor };
});
---

<section class="radar" id="analiz">
  <div class="container">
    <div class="radar__head">
      <SectionHeading
        index="06"
        eyebrow="Finansal hakimiyet & karar destek"
        title="Cari ön analizleri ve 5 boyutlu finansal radar"
        description="Cari ekranında anlık müşteri durumunu görün; detaylı analiz panelinde tüm işletmenizi beş boyutta yönetin: yüksek bakiye, hızlı artış trendi, geciken veresiyeler, uzayan hesaplar ve gelecek nakit akışı."
      />
      <p class="radar__disclaimer">
        <Icon name="target" size={15} />
        Grafikteki değerler temsili demo verisidir.
      </p>
    </div>

    <div class="radar__panel">
      <div class="radar__chart-card">
        <div class="radar__chart-head">
          <p class="radar__chart-title">Finansal radar</p>
          <span class="radar__chart-badge">5 boyut</span>
        </div>

        <svg
          class="radar__chart"
          viewBox="-10 -8 340 316"
          role="img"
          aria-label="Beş boyutlu finansal radar grafiği: yüksek, artan, geciken, uzayan ve gelecek. Değerler temsili demo verisidir."
        >
          <g class="radar__rings">
            {rings.map((ring) => <polygon points={ring} />)}
          </g>

          <g class="radar__spokes">
            {
              spokes.map((spoke, i) => (
                <line
                  x1={cx}
                  y1={cy}
                  x2={spoke.x}
                  y2={spoke.y}
                  data-radar-spoke={i}
                  class:list={[i === 0 && 'is-active']}
                />
              ))
            }
          </g>

          <polygon class="radar__area" points={dataPolygon} />

          <g class="radar__points">
            {
              RADAR_DIMENSIONS.map((_, i) => {
                const p = point(i, radius * dataValues[i]);
                return (
                  <circle
                    cx={p.x}
                    cy={p.y}
                    r={i === 0 ? 4.5 : 3.2}
                    class:list={['radar__dot', i === 0 && 'is-active']}
                    data-radar-dot={i}
                  />
                );
              })
            }
          </g>

          <g class="radar__labels">
            {
              labels.map((label, i) => (
                <text
                  x={label.x}
                  y={label.y}
                  text-anchor={label.anchor}
                  class:list={['radar__label', i === 0 && 'is-active']}
                  data-radar-label={i}
                >
                  {label.label}
                </text>
              ))
            }
          </g>
        </svg>

        <p class="radar__chart-foot">
          <span class="radar__legend-dot" aria-hidden="true"></span>
          Örnek dağılım · 5 boyut
        </p>
      </div>

      <div class="radar__detail">
        <div class="radar__tabs" role="tablist" aria-label="Finansal radar boyutları">
          {
            RADAR_DIMENSIONS.map((dimension, i) => (
              <button
                type="button"
                class:list={['radar__tab', i === 0 && 'is-active']}
                role="tab"
                id={`radar-tab-${dimension.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`radar-panel-${dimension.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-radar-tab={i}
              >
                <span class="radar__tab-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="radar__tab-label">{dimension.label}</span>
              </button>
            ))
          }
        </div>

        <div class="radar__panels" aria-live="polite">
          {
            RADAR_DIMENSIONS.map((dimension, i) => (
              <div
                class="radar__info"
                role="tabpanel"
                id={`radar-panel-${dimension.id}`}
                aria-labelledby={`radar-tab-${dimension.id}`}
                tabindex="0"
                data-radar-panel={i}
              >
                <p class="radar__kicker">Boyut {i + 1} / 5</p>
                <h3 class="radar__info-title">{dimension.title}</h3>
                <p class="radar__info-text">{dimension.description}</p>

                <div class="radar__metric">
                  <span>{dimension.metricLabel}</span>
                  <strong>{dimension.metric}</strong>
                </div>

                <ul class="radar__rows">
                  {dimension.rows.map((row) => (
                    <li>
                      <span class="radar__row-name">{row.name}</span>
                      <span class="radar__row-meta">{row.meta}</span>
                      <span class="radar__row-value">{row.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .radar {
    padding-block: var(--space-9);
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }

  .radar__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .radar__head :global(.section-heading) {
    margin-bottom: var(--space-6);
  }

  .radar__disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding-bottom: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .radar__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: var(--space-4);
  }

  /* ---- Grafik kartı ---- */
  .radar__chart-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(320px 220px at 50% 0%, rgb(6 182 212 / 0.18), transparent 68%),
      linear-gradient(165deg, #10265a 0%, #0b1e4b 55%, #071431 100%);
    color: rgb(226 234 248 / 0.8);
    box-shadow: var(--shadow-lg);
    border: 1px solid rgb(255 255 255 / 0.08);
  }

  .radar__chart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .radar__chart-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .radar__chart-badge {
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-cyan-300);
  }

  .radar__chart {
    width: 100%;
    height: auto;
    margin-block: auto;
    max-width: 440px;
    margin-inline: auto;
  }

  .radar__rings polygon {
    fill: none;
    stroke: rgb(255 255 255 / 0.09);
    stroke-width: 1;
  }

  .radar__rings polygon:last-child {
    stroke: rgb(255 255 255 / 0.16);
  }

  .radar__spokes line {
    stroke: rgb(255 255 255 / 0.12);
    stroke-width: 1;
    transition: stroke var(--duration-base) var(--ease-out);
  }

  .radar__spokes line.is-active {
    stroke: var(--color-cyan-300);
    stroke-width: 1.6;
  }

  .radar__area {
    fill: rgb(6 182 212 / 0.16);
    stroke: var(--color-cyan-300);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .radar__dot {
    fill: #0b1e4b;
    stroke: var(--color-cyan-300);
    stroke-width: 1.5;
    transition:
      r var(--duration-base) var(--ease-out),
      fill var(--duration-base) var(--ease-out);
  }

  .radar__dot.is-active {
    fill: var(--color-cyan-300);
  }

  .radar__label {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 600;
    fill: rgb(226 234 248 / 0.62);
    letter-spacing: 0.02em;
    transition: fill var(--duration-base) var(--ease-out);
  }

  .radar__label.is-active {
    fill: var(--color-cyan-300);
  }

  .radar__chart-foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.625rem;
    color: rgb(226 234 248 / 0.45);
  }

  .radar__legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cyan-300);
  }

  /* ---- Detay kartı ---- */
  .radar__detail {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .radar__tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.35rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .radar__tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    min-height: 48px;
    padding: 0.45rem 0.55rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .radar__tab:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-border);
  }

  .radar__tab.is-active {
    background: linear-gradient(160deg, var(--color-navy-800), var(--color-navy-950));
    border-color: var(--color-navy-800);
    box-shadow: var(--shadow-sm);
  }

  .radar__tab-num {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .radar__tab.is-active .radar__tab-num {
    color: var(--color-cyan-300);
  }

  .radar__tab-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .radar__tab.is-active .radar__tab-label {
    color: #fff;
  }

  .radar__panels {
    position: relative;
    flex: 1;
  }

  .radar__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-4) 0.35rem 0.35rem;
    min-height: 306px;
  }

  .radar__info[hidden] {
    display: none;
  }

  .radar__kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .radar__info-title {
    font-size: var(--text-h3);
    color: var(--color-ink);
    line-height: 1.25;
  }

  .radar__info-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 52ch;
  }

  .radar__metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 0.25rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
  }

  .radar__metric span {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .radar__metric strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .radar__rows {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
    display: grid;
  }

  .radar__rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem 0.75rem;
    padding: 0.5rem 0.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .radar__rows li:last-child {
    border-bottom: 0;
  }

  .radar__row-name {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .radar__row-meta {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .radar__row-value {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 1040px) {
    .radar__panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .radar__chart {
      max-height: 420px;
    }

    .radar__head {
      display: block;
    }

    .radar__disclaimer {
      display: flex;
      padding-bottom: var(--space-5);
    }

    .radar__info {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .radar__tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .radar__chart-card {
      padding: var(--space-4);
    }

    .radar__detail {
      padding: var(--space-3);
    }
  }
</style>

<script is:inline>
  const tabs = Array.from(document.querySelectorAll('[data-radar-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-radar-panel]'));
  const spokes = Array.from(document.querySelectorAll('[data-radar-spoke]'));
  const dots = Array.from(document.querySelectorAll('[data-radar-dot]'));
  const labels = Array.from(document.querySelectorAll('[data-radar-label]'));

  if (tabs.length === panels.length && panels.length > 0) {
    // JS yoksa tüm boyut panelleri üst üste görünür kalır.
    panels.forEach((panel, i) => {
      if (i > 0) panel.setAttribute('hidden', '');
    });

    const activate = (index, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
        if (active && focus) tab.focus();
      });

      panels.forEach((panel, i) => {
        if (i === index) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });

      [spokes, dots, labels].forEach((group) => {
        group.forEach((node, i) => node.classList.toggle('is-active', i === index));
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          return;
        }
        event.preventDefault();
        let next = i;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (i + 1) % tabs.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        activate(next, true);
      });
    });
  }
</script>
