---
/**
 * Dekoratif QR deseni — gerçek bir yönlendirme taşımaz.
 * 25x25 modül, üç konumlandırma deseni ve zamanlama çizgileriyle
 * QR görünümünü CSS/SVG ile üretir. Ekran okuyuculardan gizlenir;
 * yanındaki metin işlevi açıklar.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 120, class: className } = Astro.props;

const gridSize = 25;
const grid: boolean[][] = Array.from({ length: gridSize }, () =>
  Array.from({ length: gridSize }, () => false),
);

function placeFinder(ox: number, oy: number) {
  for (let y = -1; y <= 7; y++) {
    for (let x = -1; x <= 7; x++) {
      const gx = ox + x;
      const gy = oy + y;
      if (gx >= 0 && gx < gridSize && gy >= 0 && gy < gridSize) grid[gy][gx] = false;
    }
  }
  for (let y = 0; y < 7; y++) {
    for (let x = 0; x < 7; x++) {
      const edge = x === 0 || x === 6 || y === 0 || y === 6;
      const core = x >= 2 && x <= 4 && y >= 2 && y <= 4;
      grid[oy + y][ox + x] = edge || core;
    }
  }
}

placeFinder(0, 0);
placeFinder(18, 0);
placeFinder(0, 18);

// Zamanlama desenleri
for (let i = 8; i < 17; i += 2) {
  grid[6][i] = true;
  grid[i][6] = true;
}

// Hizalama deseni
for (let y = 0; y < 5; y++) {
  for (let x = 0; x < 5; x++) {
    const edge = x === 0 || x === 4 || y === 0 || y === 4;
    const core = x === 2 && y === 2;
    grid[16 + y][16 + x] = edge || core;
  }
}

// Deterministik sözde-rastgele dolgu
let seed = 20261106;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};

for (let y = 0; y < gridSize; y++) {
  for (let x = 0; x < gridSize; x++) {
    const inFinder =
      (x < 8 && y < 8) || (x > 16 && y < 8) || (x < 8 && y > 16) || (x >= 16 && y >= 16);
    const inTiming = x === 6 || y === 6;
    if (!inFinder && !inTiming && rand() > 0.52) grid[y][x] = true;
  }
}

const cells: { x: number; y: number }[] = [];
for (let y = 0; y < gridSize; y++) {
  for (let x = 0; x < gridSize; x++) {
    if (grid[y][x]) cells.push({ x, y });
  }
}
---

<svg
  class:list={['qr-pattern', className]}
  width={size}
  height={size}
  viewBox="-1.5 -1.5 28 28"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  <rect x="-1.5" y="-1.5" width="28" height="28" rx="1.5" fill="#ffffff" />
  {cells.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" fill="currentColor" />)}
</svg>

<style>
  .qr-pattern {
    display: block;
    color: var(--color-navy-900);
  }
</style>
