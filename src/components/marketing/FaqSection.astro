---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from './Icon.astro';
import { FAQ_ITEMS } from '../../data/marketing';
import { LINKS } from '../../data/site';
---

<section class="faq" id="sss">
  <div class="container faq__inner">
    <div class="faq__aside">
      <SectionHeading
        index="10"
        eyebrow="Aklınıza takılanlar"
        title="Veresiye programı hakkında sıkça sorulanlar"
      />
      <p class="faq__aside-text">
        Aradığınız yanıt burada yoksa yardım merkezindeki adım adım kılavuzlara göz atın veya
        doğrudan bize yazın.
      </p>
      <div class="faq__aside-links">
        <a href="/yardim/">
          <Icon name="ledger" size={16} />
          Yardım merkezi
        </a>
        <a href={`mailto:${LINKS.contactEmail}`}>
          <Icon name="chat" size={16} />
          {LINKS.contactEmail}
        </a>
      </div>
    </div>

    <div class="faq__list">
      {
        FAQ_ITEMS.map((item, i) => (
          <details class="faq__item">
            <summary>
              <span class="faq__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq__question">{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <span class="faq__icon-bar"></span>
                <span class="faq__icon-bar faq__icon-bar--vertical"></span>
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-9);
    background: var(--color-surface);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    padding-top: 0.25rem;
  }

  .faq__aside :global(.section-heading) {
    margin-bottom: var(--space-4);
  }

  .faq__aside-text {
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-muted);
  }

  .faq__aside-links {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-5);
  }

  .faq__aside-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--color-primary);
    text-decoration: none;
    word-break: break-word;
  }

  .faq__aside-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq__list {
    display: grid;
    gap: 0.6rem;
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .faq__item[open] {
    border-color: rgb(29 78 216 / 0.32);
    box-shadow: var(--shadow-sm);
  }

  .faq__item summary {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-4);
    cursor: pointer;
    list-style: none;
    min-height: 56px;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
    border-radius: var(--radius-lg);
  }

  .faq__num {
    flex: none;
    padding-top: 0.1rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .faq__question {
    flex: 1;
    font-family: var(--font-display);
    font-size: 0.9688rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .faq__item summary:hover .faq__question {
    color: var(--color-primary);
  }

  .faq__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: none;
    margin-top: -1px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .faq__icon-bar {
    position: absolute;
    width: 10px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--color-primary);
  }

  .faq__icon-bar--vertical {
    transform: rotate(90deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__item[open] .faq__icon {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
  }

  .faq__item[open] .faq__icon .faq__icon-bar {
    background: var(--color-cyan-300);
  }

  .faq__item[open] .faq__icon-bar--vertical {
    transform: rotate(0deg);
  }

  .faq__answer {
    padding: 0 var(--space-5) var(--space-4) calc(var(--space-4) + 2rem);
    animation: faq-in 200ms var(--ease-out);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .faq__answer p {
    font-size: var(--text-sm);
    line-height: 1.68;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .faq__aside {
      position: static;
    }

    .faq__aside-text {
      max-width: 52ch;
    }

    .faq__aside-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1.5rem;
    }
  }

  @media (max-width: 520px) {
    .faq__answer {
      padding-left: calc(var(--space-4) + 1.5rem);
      padding-right: var(--space-4);
    }
  }
</style>
