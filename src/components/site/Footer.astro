---
import SiteBrand from './SiteBrand.astro';
import { FOOTER_GROUPS, LINKS, SITE } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__glow" aria-hidden="true"></div>

  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <SiteBrand width={30} />
      <p class="site-footer__desc">
        Küçük işletmeler, esnaflar ve serbest çalışanlar için offline-first Windows veresiye
        programı ve alacak takip yazılımı.
      </p>
      <p class="site-footer__contact">
        <span>Destek</span>
        <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>
      </p>
      <ul class="site-footer__chips">
        <li>Windows 10 &amp; 11</li>
        <li>Masaüstü uygulaması</li>
      </ul>
    </div>

    {
      FOOTER_GROUPS.map((group) => (
        <nav class="site-footer__col" aria-label={group.title}>
          <p class="site-footer__col-title">{group.title}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {SITE.name}. Tüm hakları saklıdır.</p>
    <p>Windows masaüstü uygulaması · Windows 10 ve Windows 11 ile tam uyumlu</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(720px 320px at 8% 0%, rgb(29 78 216 / 0.28), transparent 70%),
      linear-gradient(180deg, #0a1c45 0%, #071431 100%);
    color: rgb(214 224 240 / 0.78);
    margin-top: auto;
    border-top: 1px solid rgb(255 255 255 / 0.06);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), var(--color-primary), transparent);
    opacity: 0.55;
  }

  .site-footer__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(100% 80% at 50% 0%, #000 0%, transparent 75%);
    pointer-events: none;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.8fr repeat(3, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
  }

  .site-footer__desc {
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-top: var(--space-4);
    max-width: 38ch;
    color: rgb(214 224 240 / 0.68);
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .site-footer__contact span {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(214 224 240 / 0.65);
  }

  .site-footer__contact a {
    color: var(--color-cyan-300);
    text-decoration: none;
  }

  .site-footer__contact a:hover {
    text-decoration: underline;
  }

  .site-footer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .site-footer__chips li {
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    color: rgb(214 224 240 / 0.7);
  }

  .site-footer__col-title {
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-4);
  }

  .site-footer__col-title::after {
    content: '';
    display: block;
    width: 20px;
    height: 2px;
    margin-top: 0.6rem;
    border-radius: 2px;
    background: var(--color-accent);
    opacity: 0.65;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__col a {
    display: inline-block;
    color: rgb(214 224 240 / 0.72);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.5;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__col a:hover,
  .site-footer__col a:focus-visible {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--text-xs);
    color: rgb(214 224 240 / 0.72);
  }

  .site-footer :global(.logo) {
    color: #fff;
  }

  .site-footer :global(.logo__pro) {
    color: var(--color-cyan-300);
  }

  @media (max-width: 960px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
