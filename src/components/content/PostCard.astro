---
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import { formatDateLong } from '../../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, cover, coverAlt } = post.data;
---

<article class="card post-card">
  {
    cover && (
      <img
        src={cover}
        alt={coverAlt ?? `${title} yazısı görseli`}
        class="post-card__cover"
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="post-card__body">
    <p class="card__meta"><time datetime={date.toISOString()}>{formatDateLong(date)}</time></p>
    <h2 class="card__title">
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>
    <p class="card__text">{description}</p>
    {
      tags.length > 0 && (
        <p class="post-card__tags">
          {tags.map((tag) => (
            <Badge tone="neutral">{tag}</Badge>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .post-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .post-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .post-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .post-card__title a:hover,
  .post-card__title a:focus-visible {
    color: var(--color-primary);
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
</style>
