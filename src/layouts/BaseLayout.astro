---
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import soraLatinExt from '@fontsource-variable/sora/files/sora-latin-ext-wght-normal.woff2?url';
import SEO from '../components/seo/SEO.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import type { StructuredDataInput } from '../utils/seo';

// Yalnızca latin ve latin-ext alt kümeleri: Türkçe (ğ, ş, İ, ı) latin-ext
// dosyasından gelir; fontsource'un varsayılan tüm alt kümeleri yüklenmez.
const unicodeLatin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const unicodeLatinExt =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const fontFaces = `
@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url('${manropeLatinExt}') format('woff2-variations');unicode-range:${unicodeLatinExt}}
@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url('${manropeLatin}') format('woff2-variations');unicode-range:${unicodeLatin}}
@font-face{font-family:'Sora Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url('${soraLatinExt}') format('woff2-variations');unicode-range:${unicodeLatinExt}}
@font-face{font-family:'Sora Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url('${soraLatin}') format('woff2-variations');unicode-range:${unicodeLatin}}
`;

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string | false;
  author?: string;
  wide?: boolean;
  bodyClass?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  structuredData?: StructuredDataInput;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  canonical,
  author,
  wide = false,
  bodyClass,
  publishedAt,
  updatedAt,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="tr-TR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1e4b" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={manropeLatinExt}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={soraLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={soraLatinExt}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <style is:inline set:html={fontFaces}></style>
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      canonical={canonical}
      author={author}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
    />
    <StructuredData {...structuredData} />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    {
      wide && <style>:root { --container: 1360px; }</style>
    }
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip-link" href="#main-content">İçeriğe geç</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Scroll reveal — prefers-reduced-motion durumunda CSS devre dışıdır.
      const revealables = document.querySelectorAll('.reveal');
      if (revealables.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
