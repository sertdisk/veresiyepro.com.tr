---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Badge from '../components/ui/Badge.astro';
import { formatDateLong } from '../utils/format';
import { toBreadcrumbs } from '../utils/seo';

interface Props {
  title: string;
  description?: string;
  updated?: Date;
  crumbs: { label: string; href?: string }[];
  otherDocs: { id: string; title: string }[];
  canonicalURL?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  updated,
  crumbs,
  otherDocs,
  canonicalURL,
  noindex = false,
  image,
  imageAlt,
} = Astro.props;

const breadcrumbs = toBreadcrumbs(crumbs);
---

<BaseLayout
  title={`${title} | Veresiye Pro`}
  description={description}
  type="article"
  updatedAt={updated}
  canonical={canonicalURL}
  noindex={noindex}
  image={image}
  imageAlt={imageAlt}
  structuredData={{
    breadcrumbs,
    webPage: {
      name: title,
      description,
      dateModified: updated,
    },
  }}
>
  <PageHero
    eyebrow="Yasal"
    title={title}
    description={description}
    meta={updated ? `Son güncelleme: ${formatDateLong(updated)}` : undefined}
  />

  <div class="container section legal-shell">
    <Breadcrumbs items={crumbs} />

    <div class="legal-shell__layout">
      <article class="legal-shell__doc">
        {
          updated && (
            <p class="legal-shell__stamp">
              <Badge tone="neutral">Son güncelleme</Badge>
              <time datetime={updated.toISOString()}>{formatDateLong(updated)}</time>
            </p>
          )
        }
        <slot />
      </article>

      <aside class="legal-shell__aside" aria-labelledby="legal-aside-title">
        <div class="legal-shell__card">
          <p class="legal-shell__aside-title" id="legal-aside-title">Diğer yasal belgeler</p>
          <ul>
            {
              otherDocs.map((other) => (
                <li>
                  <a href={`/yasal/${other.id}/`}>{other.title}</a>
                </li>
              ))
            }
          </ul>
          <div class="legal-shell__print">
            <p>Bu belge yazdırmaya uygun biçimlendirilmiştir.</p>
            <button type="button" class="legal-shell__print-btn" data-print-page>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9V3h12v6" />
                <rect x="3" y="9" width="18" height="8" rx="2" />
                <path d="M6 17h12v4H6z" />
              </svg>
              Yazdır
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    const printButton = document.querySelector('[data-print-page]');
    printButton?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>

<style>
  .legal-shell__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 292px;
    gap: var(--space-8);
    align-items: start;
  }

  .legal-shell__stamp {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .legal-shell__aside {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .legal-shell__card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
    box-shadow: var(--shadow-xs);
  }

  .legal-shell__aside-title {
    font-family: var(--font-display);
    font-weight: 650;
    color: var(--color-ink);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .legal-shell__card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .legal-shell__card li + li {
    border-top: 1px solid var(--color-border);
  }

  .legal-shell__card a {
    display: block;
    padding: 0.55rem 0;
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .legal-shell__card a:hover,
  .legal-shell__card a:focus-visible {
    color: var(--color-primary);
  }

  .legal-shell__print {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .legal-shell__print p {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .legal-shell__print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .legal-shell__print-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  @media (max-width: 1000px) {
    .legal-shell__layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .legal-shell__aside {
      position: static;
      order: 2;
    }
  }

  @media print {
    .legal-shell__layout {
      display: block;
    }

    .legal-shell__stamp,
    .legal-shell__aside {
      display: none !important;
    }
  }
</style>
