---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Prose from '../../components/ui/Prose.astro';
import Toc from '../../components/ui/Toc.astro';
import PostCard from '../../components/content/PostCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { formatDateLong, isPublished, sortByDateDesc } from '../../utils/format';
import { SITE } from '../../data/site';

export type Props = {
  index?: boolean;
  post?: CollectionEntry<'blog'>;
};

// Blog bölümü yalnızca en az bir yayında yazı varsa inşa edilir.
// Yazı yoksa getStaticPaths boş dizi döner; /blog/ rotası hiç üretilmez
// (Header.astro da bu durumda Blog bağlantısını gizler).
export async function getStaticPaths() {
  const published = sortByDateDesc(await getCollection('blog', isPublished));
  if (published.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { index: true } satisfies Props },
    ...published.map((post) => ({
      params: { slug: post.id },
      props: { post } satisfies Props,
    })),
  ];
}

const { index, post } = Astro.props as Props;

const posts = index
  ? sortByDateDesc(await getCollection('blog', isPublished))
  : [];

const rendered = post ? await render(post) : null;
const BlogContent = rendered?.Content ?? null;
const blogIndexCrumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Blog' },
];
const postCrumbs = post
  ? [
      { label: 'Ana Sayfa', href: '/' },
      { label: 'Blog', href: '/blog/' },
      { label: post?.data.title ?? '' },
    ]
  : blogIndexCrumbs;
---

{
  index && posts ? (
    <BaseLayout
      title="Blog — Veresiye Pro"
      description="Veresiye yönetimi, tahsilat stratejileri ve küçük işletme ipuçları üzerine yazılar."
      structuredData={{
        breadcrumbs: blogIndexCrumbs.map(({ label, href }) => ({ name: label, url: href })),
      }}
    >
      <PageHero
        eyebrow="Blog"
        title="Veresiye Pro Blog"
        description="Veresiye takibi, tahsilat stratejileri ve küçük işletme ipuçları üzerine yazılar."
      />
      <div class="container section">
        <Breadcrumbs items={blogIndexCrumbs} />
        <div class="card-grid blog-grid">
          {posts.map((entry) => (
            <PostCard post={entry} />
          ))}
        </div>
      </div>
    </BaseLayout>
  ) : post && rendered && BlogContent ? (
    <BaseLayout
      title={`${post.data.title} | Veresiye Pro Blog`}
      description={post.data.description}
      type="article"
      publishedAt={post.data.date}
      updatedAt={post.data.updated ?? post.data.date}
      image={post.data.cover}
      imageAlt={post.data.coverAlt}
      canonical={post.data.canonicalURL}
      noindex={post.data.noindex}
      author={post.data.author}
      structuredData={{
        breadcrumbs: postCrumbs.map(({ label, href }) => ({ name: label, url: href })),
        article: {
          type: 'BlogPosting',
          headline: post.data.title,
          description: post.data.description,
          datePublished: post.data.date,
          dateModified: post.data.updated ?? post.data.date,
          author: post.data.author,
          image: post.data.cover,
        },
      }}
      wide
    >
      <PageHero
        eyebrow="Blog"
        title={post.data.title}
        description={post.data.description}
        meta={`${post.data.author} · ${formatDateLong(post.data.date)}`}
      />
      <div class="container section blog-post">
        <Breadcrumbs items={postCrumbs} />
        <div class="blog-post__layout">
          <article>
            {post.data.cover && (
              <figure class="blog-post__cover">
                <img
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? `${post.data.title} yazısı görseli`}
                  width="1200"
                  height="675"
                />
              </figure>
            )}
            <div class="blog-post__meta">
              <p>
                {post.data.author} ·
                <time datetime={post.data.date.toISOString()}>
                  {formatDateLong(post.data.date)}
                </time>
              </p>
              {post.data.tags.length > 0 && (
                <p class="blog-post__tags">
                  {post.data.tags.map((tag) => (
                    <Badge tone="neutral">{tag}</Badge>
                  ))}
                </p>
              )}
            </div>
            <Prose>
              <BlogContent />
            </Prose>
            <p class="blog-post__back">
              <Button variant="secondary" href="/blog/">
                ← Tüm yazılara dön
              </Button>
            </p>
          </article>
          <aside class="blog-post__aside">
            <Toc headings={rendered.headings} />
            <p class="blog-post__brand-note">{SITE.keyboardCompatible}</p>
          </aside>
        </div>
      </div>
    </BaseLayout>
  ) : null
}

<style>
  .blog-post__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: var(--space-7);
  }

  .blog-post__cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-5);
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .blog-post__back {
    margin-top: var(--space-7);
  }

  .blog-post__brand-note {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 1100px) {
    .blog-post__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
