---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Prose from '../../components/ui/Prose.astro';
import Toc from '../../components/ui/Toc.astro';
import Badge from '../../components/ui/Badge.astro';
import { formatDateLong, isPublished, sortByDateDesc } from '../../utils/format';

export async function getStaticPaths() {
  const releases = await getCollection('releases', isPublished);
  return releases.map((release) => ({
    params: { slug: release.id },
    props: { release },
  }));
}

const { release } = Astro.props as { release: CollectionEntry<'releases'> };
const { Content, headings } = await render(release);
const {
  title,
  version,
  date,
  summary,
  description,
  updated,
  highlights,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonicalURL,
  noindex,
} = release.data;

const all = sortByDateDesc(await getCollection('releases', isPublished));
const index = all.findIndex((r) => r.id === release.id);
const previous = index < all.length - 1 ? all[index + 1] : null;

const crumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Sürüm Notları', href: '/surum-notlari/' },
  { label: `v${version}` },
];
---

<BaseLayout
  title={`Veresiye Pro ${version} Sürüm Notları — Windows Veresiye Programı`}
  description={description ?? summary ?? `Veresiye Pro ${version} yenilikleri ve kararlılık geliştirmeleri.`}
  type="article"
  canonical={canonicalURL}
  noindex={noindex}
  image={image}
  imageAlt={imageAlt}
  publishedAt={date}
  updatedAt={updated ?? date}
  author="Veresiye Pro"
  structuredData={{
    breadcrumbs: crumbs.map(({ label, href }) => ({ name: label, url: href })),
    article: {
      type: 'Article',
      headline: title,
      description: description ?? summary,
      datePublished: date,
      dateModified: updated ?? date,
      author: 'Veresiye Pro',
      image,
    },
  }}
  wide
>
  <PageHero
    eyebrow={`Sürüm ${version}`}
    title={title}
    description={summary}
    meta={`Yayın tarihi: ${formatDateLong(date)}`}
  />
  <div class="container section release-detail">
    <Breadcrumbs items={crumbs} />
    <div class="release-detail__layout">
      <article class="release-detail__main">
        <div class="release-detail__badges">
          <Badge tone="primary">{`v${version}`}</Badge>
          <time datetime={date.toISOString()}>{formatDateLong(date)}</time>
          <Badge tone="gold">Güncel Windows Veresiye Programı</Badge>
        </div>

        {
          highlights.length > 0 && (
            <section class="release-detail__highlights" aria-label="Öne çıkan yenilikler">
              <h2>Öne Çıkan Yenilikler</h2>
              <ul>
                {highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          image && (
            <figure>
              <img
                src={image}
                alt={imageAlt ?? `Veresiye Pro ${version} ekran görseli`}
                width={imageWidth ?? 1200}
                height={imageHeight ?? 675}
                loading="lazy"
              />
            </figure>
          )
        }

        <Prose>
          <Content />
        </Prose>

        <nav class="release-detail__related" aria-labelledby="release-related-title">
          <h2 id="release-related-title">İlgili Yardım Konuları</h2>
          <ul>
            <li><a href="/yardim/cari-ekleme/">Cari hesap ekleme ve bakiye mantığı</a></li>
            <li><a href="/yardim/vadeli-taksitli-veresiye/">Vadeli ve taksitli veresiye kaydı</a></li>
            <li><a href="/yardim/tahsilat-kaydi/">Tahsilat kaydı ve kasa takibi</a></li>
          </ul>
        </nav>

        <nav class="release-detail__nav" aria-label="Sürüm navigasyonu">
          {
            previous ? (
              <a href={`/surum-notlari/${previous.id}/`} class="release-detail__nav-link">
                ← Önceki sürüm: v{previous.data.version} — {previous.data.title}
              </a>
            ) : (
              <span />
            )
          }
          <a href="/surum-notlari/" class="release-detail__nav-link">Tüm sürüm notları →</a>
        </nav>
      </article>

      <aside class="release-detail__aside">
        <Toc headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .release-detail__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-7);
  }

  .release-detail__badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .release-detail__highlights {
    background: rgb(29 78 216 / 0.04);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .release-detail__highlights h2 {
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .release-detail__highlights ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .release-detail__highlights li {
    padding-left: 1.5rem;
    position: relative;
  }

  .release-detail__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .release-detail__related {
    margin-top: var(--space-7);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .release-detail__related h2 {
    font-size: var(--text-md);
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }

  .release-detail__related ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }

  .release-detail__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    flex-wrap: wrap;
  }

  .release-detail__nav-link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .release-detail__nav-link:hover {
    text-decoration: underline;
  }

  .release-detail figure {
    margin: 0 0 var(--space-5);
  }

  .release-detail img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 1100px) {
    .release-detail__layout {
      grid-template-columns: 1fr;
    }

    .release-detail__aside {
      order: -1;
    }

    .release-detail__aside .toc {
      position: static;
    }
  }
</style>
